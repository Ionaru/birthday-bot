{
    "compilerOptions": {
        // Node runs the TypeScript in apps/*/src and libs/*/src directly, stripping types as it
        // loads. tsc is only ever used to typecheck, hence noEmit.
        "allowImportingTsExtensions": true,
        "noEmit": true,

        // Rejects anything Node's type stripping cannot erase: enums, namespaces,
        // constructor parameter properties and decorators. This is what keeps the
        // no-build setup honest.
        "erasableSyntaxOnly": true,
        "verbatimModuleSyntax": true,

        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "isolatedModules": true,
        "lib": [
            "es2024"
        ],
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "noFallthroughCasesInSwitch": true,
        "noImplicitOverride": true,
        "noImplicitReturns": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "strict": true,
        "target": "es2024",
        "types": [
            "node"
        ]
    },
    "include": [
        "apps/*/src/**/*.ts",
        "libs/*/src/**/*.ts"
    ]
}
